\pard\f1\fs17\b0\sl200\slmult0\sa0 \par
\pard\f1\fs17\b0\sl200\slmult0\sa0 \cf5 def\cf1  main() -> \cf5 None\cf1 :\par
\pard\f1\fs17\b0\sl200\slmult0\sa0 \cf1     \cf3 """Display the answers for parts a through f."""\par
\pard\f1\fs17\b0\sl200\slmult0\sa0 \cf1     print(\cf3 "Student: Jorge Alfaro | FAU ID: Z23697022 | Problem 2"\cf1 )\par
\pard\f1\fs17\b0\sl200\slmult0\sa0 \par
\pard\f1\fs17\b0\sl200\slmult0\sa0 \cf1     \cf2 # a. Include every ordered tuple of four distinct integers.\par
\pard\f1\fs17\b0\sl200\slmult0\sa0 \cf1     equal_squares = [\par
\pard\f1\fs17\b0\sl200\slmult0\sa0 \cf1         (a, b, c, d)\par
\pard\f1\fs17\b0\sl200\slmult0\sa0 \cf1         \cf5 for\cf1  a \cf5 in\cf1  range(\cf4 1\cf1 , \cf4 11\cf1 ) \cf5 for\cf1  b \cf5 in\cf1  range(\cf4 1\cf1 , \cf4 11\cf1 )\par
\pard\f1\fs17\b0\sl200\slmult0\sa0 \cf1         \cf5 for\cf1  c \cf5 in\cf1  range(\cf4 1\cf1 , \cf4 11\cf1 ) \cf5 for\cf1  d \cf5 in\cf1  range(\cf4 1\cf1 , \cf4 11\cf1 )\par
\pard\f1\fs17\b0\sl200\slmult0\sa0 \cf1         \cf5 if\cf1  len(\{a, b, c, d\}) == \cf4 4\cf1  \cf5 and\cf1  a * a + b * b == c * c + d * d\par
\pard\f1\fs17\b0\sl200\slmult0\sa0 \cf1     ]\par
\pard\f1\fs17\b0\sl200\slmult0\sa0 \cf1     print(\cf3 "a:"\cf1 , equal_squares)\par
\pard\f1\fs17\b0\sl200\slmult0\sa0 \par
\pard\f1\fs17\b0\sl200\slmult0\sa0 \cf1     \cf2 # b. Lowercase words whose original length is less than five.\par
\pard\f1\fs17\b0\sl200\slmult0\sa0 \cf1     words = [\cf3 'One'\cf1 , \cf3 'SEVEN'\cf1 , \cf3 'three'\cf1 , \cf3 'two'\cf1 , \cf3 'Ten'\cf1 ]\par
\pard\f1\fs17\b0\sl200\slmult0\sa0 \cf1     short_words = [(word.lower(), len(word)) \cf5 for\cf1  word \cf5 in\cf1  words \cf5 if\cf1  len(word) < \cf4 5\cf1 ]\par
\pard\f1\fs17\b0\sl200\slmult0\sa0 \cf1     print(\cf3 "b:"\cf1 , short_words)\par
\pard\f1\fs17\b0\sl200\slmult0\sa0 \par
\pard\f1\fs17\b0\sl200\slmult0\sa0 \cf1     \cf2 # c. Abbreviate the middle name in each three-part name.\par
\pard\f1\fs17\b0\sl200\slmult0\sa0 \cf1     names = [\cf3 'Christopher Ashton Kutcher'\cf1 , \cf3 'Elizabeth Stamatina Fey'\cf1 ]\par
\pard\f1\fs17\b0\sl200\slmult0\sa0 \cf1     abbreviated = [\par
\pard\f1\fs17\b0\sl200\slmult0\sa0 \cf1         f"\{first\} \{middle[\cf4 0\cf1 ]\}. \{last\}"\par
\pard\f1\fs17\b0\sl200\slmult0\sa0 \cf1         \cf5 for\cf1  name \cf5 in\cf1  names \cf5 for\cf1  first, middle, last \cf5 in\cf1  [name.split()]\par
\pard\f1\fs17\b0\sl200\slmult0\sa0 \cf1     ]\par
