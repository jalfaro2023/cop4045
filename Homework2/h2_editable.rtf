\pard\f1\fs17\b0\sl200\slmult0\sa0 \cf2 # testif module \par
\pard\f1\fs17\b0\sl200\slmult0\sa0 \par
\pard\f1\fs17\b0\sl200\slmult0\sa0 \cf5 def\cf1  testif(b, testname, msgOK=\cf3 ""\cf1 , msgFailed=\cf3 ""\cf1 ):\par
\pard\f1\fs17\b0\sl200\slmult0\sa0 \cf1     \cf3 """Function used for testing. \par
\pard\f1\fs17\b0\sl200\slmult0\sa0 \cf3     param b: boolean, normally a tested condition: true if test passed, false otherwise\par
\pard\f1\fs17\b0\sl200\slmult0\sa0 \cf3     param testname: the test name\par
\pard\f1\fs17\b0\sl200\slmult0\sa0 \cf3     param msgOK: string to be printed if param b==True  ( test condition true)\par
\pard\f1\fs17\b0\sl200\slmult0\sa0 \cf3     param msgFailed: string to be printed if param b==False\par
\pard\f1\fs17\b0\sl200\slmult0\sa0 \cf3     returns b\par
\pard\f1\fs17\b0\sl200\slmult0\sa0 \cf3     """\par
\pard\f1\fs17\b0\sl200\slmult0\sa0 \cf1     \cf5 if\cf1  b:\par
\pard\f1\fs17\b0\sl200\slmult0\sa0 \cf1         print(\cf3 "Success: "\cf1 + testname + \cf3 "; "\cf1  + msgOK)\par
\pard\f1\fs17\b0\sl200\slmult0\sa0 \cf1     \cf5 else\cf1 :\par
\pard\f1\fs17\b0\sl200\slmult0\sa0 \cf1         print(\cf3 "Failed: "\cf1 + testname + \cf3 "; "\cf1  + msgFailed)\par
\pard\f1\fs17\b0\sl200\slmult0\sa0 \cf1     \cf5 return\cf1  b\par
