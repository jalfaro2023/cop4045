\page \pard\f0\fs28\b\sl360\slmult0\sa180 \cf1 Problem 4 IMDB rankings\par
\pard\f0\fs20\b0\sl260\slmult0\sa120 \cf1 p4_Alfaro_Jorge.py\par
\pard\f1\fs17\b0\sl200\slmult0\sa0 \cf3 """Problem 4: rank director-actor collaborations and actor box office."""\par
\pard\f1\fs17\b0\sl200\slmult0\sa0 \par
\pard\f1\fs17\b0\sl200\slmult0\sa0 \cf5 import\cf1  csv\par
\pard\f1\fs17\b0\sl200\slmult0\sa0 \cf5 from\cf1  pathlib \cf5 import\cf1  Path\par
\pard\f1\fs17\b0\sl200\slmult0\sa0 \par
\pard\f1\fs17\b0\sl200\slmult0\sa0 \cf1 DATA_DIRECTORY = Path(__file__).resolve().parent\par
\pard\f1\fs17\b0\sl200\slmult0\sa0 \par
\pard\f1\fs17\b0\sl200\slmult0\sa0 \par
\pard\f1\fs17\b0\sl200\slmult0\sa0 \cf5 def\cf1  read_movies(filename: str, value_column: str) -> dict[tuple[str, str], float]:\par
\pard\f1\fs17\b0\sl200\slmult0\sa0 \cf1     \cf3 """Map (title, year) to a numeric value from a CSV with a header."""\par
\pard\f1\fs17\b0\sl200\slmult0\sa0 \cf1     \cf5 with\cf1  open(filename, newline=\cf3 ""\cf1 , encoding=\cf3 "utf-8"\cf1 ) \cf5 as\cf1  file:\par
\pard\f1\fs17\b0\sl200\slmult0\sa0 \cf1         \cf5 return\cf1  \{(row[\cf3 "Title"\cf1 ], row[\cf3 "Year"\cf1 ]): float(row[value_column])\par
\pard\f1\fs17\b0\sl200\slmult0\sa0 \cf1                 \cf5 for\cf1  row \cf5 in\cf1  csv.DictReader(file)\}\par
\pard\f1\fs17\b0\sl200\slmult0\sa0 \par
\pard\f1\fs17\b0\sl200\slmult0\sa0 \par
\pard\f1\fs17\b0\sl200\slmult0\sa0 \cf5 def\cf1  read_casts(filename: str) -> dict[tuple[str, str], tuple[str, list[str]]]:\par
\pard\f1\fs17\b0\sl200\slmult0\sa0 \cf1     \cf3 """Map (title, year) to (director, actors) from the headerless cast CSV."""\par
\pard\f1\fs17\b0\sl200\slmult0\sa0 \cf1     \cf5 with\cf1  open(filename, newline=\cf3 ""\cf1 , encoding=\cf3 "utf-8"\cf1 ) \cf5 as\cf1  file:\par
\pard\f1\fs17\b0\sl200\slmult0\sa0 \cf1         \cf5 return\cf1  \{(row[\cf4 0\cf1 ], row[\cf4 1\cf1 ]): (row[\cf4 2\cf1 ], row[\cf4 3\cf1 :]) \cf5 for\cf1  row \cf5 in\cf1  csv.reader(file)\}\par
\pard\f1\fs17\b0\sl200\slmult0\sa0 \par
\pard\f1\fs17\b0\sl200\slmult0\sa0 \par
\pard\f1\fs17\b0\sl200\slmult0\sa0 \cf5 def\cf1  display_ranking(totals: dict, limit: int | \cf5 None\cf1  = \cf5 None\cf1 ) -> \cf5 None\cf1 :\par
\pard\f1\fs17\b0\sl200\slmult0\sa0 \cf1     \cf3 """Print descending totals; None displays all and zero displays none."""\par
\pard\f1\fs17\b0\sl200\slmult0\sa0 \cf1     \cf5 if\cf1  limit \cf5 is\cf1  \cf5 not\cf1  \cf5 None\cf1  \cf5 and\cf1  limit < \cf4 0\cf1 :\par
\pard\f1\fs17\b0\sl200\slmult0\sa0 \cf1         \cf5 raise\cf1  ValueError(\cf3 "The display limit cannot be negative."\cf1 )\par
\pard\f1\fs17\b0\sl200\slmult0\sa0 \cf1     ranking = sorted(totals.items(), key=\cf5 lambda\cf1  item: (-item[\cf4 1\cf1 ], item[\cf4 0\cf1 ]))\par
\pard\f1\fs17\b0\sl200\slmult0\sa0 \cf1     \cf5 for\cf1  rank, (key, total) \cf5 in\cf1  enumerate(ranking[:limit], \cf4 1\cf1 ):\par
\pard\f1\fs17\b0\sl200\slmult0\sa0 \cf1         \cf5 if\cf1  isinstance(key, tuple):\par
\pard\f1\fs17\b0\sl200\slmult0\sa0 \cf1             print(f"\{rank:2\}. \{(key[\cf4 0\cf1 ], key[\cf4 1\cf1 ], total)\}")\par
\pard\f1\fs17\b0\sl200\slmult0\sa0 \cf1         \cf5 else\cf1 :\par
\pard\f1\fs17\b0\sl200\slmult0\sa0 \cf1             print(f"\{rank:2\}. \{key\}: $\{total:,.0f\}")\par
\pard\f1\fs17\b0\sl200\slmult0\sa0 \par
\pard\f1\fs17\b0\sl200\slmult0\sa0 \par
\pard\f1\fs17\b0\sl200\slmult0\sa0 \cf5 def\cf1  display_top_collaborations(limit: int | \cf5 None\cf1  = \cf5 None\cf1 ) -> \cf5 None\cf1 :\par
\pard\f1\fs17\b0\sl200\slmult0\sa0 \cf1     \cf3 """Rank director-actor pairs by number of shared top-rated movies."""\par
\pard\f1\fs17\b0\sl200\slmult0\sa0 \cf1     rated = read_movies(str(DATA_DIRECTORY / \cf3 "imdb-top-rated.csv"\cf1 ), \cf3 "IMDb Rating"\cf1 )\par
\pard\f1\fs17\b0\sl200\slmult0\sa0 \cf1     casts = read_casts(str(DATA_DIRECTORY / \cf3 "imdb-top-casts.csv"\cf1 ))\par
\pard\f1\fs17\b0\sl200\slmult0\sa0 \cf1     totals = \{\}\par
\pard\f1\fs17\b0\sl200\slmult0\sa0 \cf1     \cf5 for\cf1  movie \cf5 in\cf1  rated:\par
\pard\f1\fs17\b0\sl200\slmult0\sa0 \cf1         director, actors = casts[movie]\par
\pard\f1\fs17\b0\sl200\slmult0\sa0 \cf1         \cf5 for\cf1  actor \cf5 in\cf1  set(actors):\par
\pard\f1\fs17\b0\sl200\slmult0\sa0 \cf1             pair = (director, actor)\par
\pard\f1\fs17\b0\sl200\slmult0\sa0 \cf1             totals[pair] = totals.get(pair, \cf4 0\cf1 ) + \cf4 1\par
\pard\f1\fs17\b0\sl200\slmult0\sa0 \cf1     display_ranking(totals, limit)\par
\pard\f1\fs17\b0\sl200\slmult0\sa0 \par
\pard\f1\fs17\b0\sl200\slmult0\sa0 \par
\pard\f1\fs17\b0\sl200\slmult0\sa0 \cf5 def\cf1  display_top_actors(limit: int | \cf5 None\cf1  = \cf5 None\cf1 ) -> \cf5 None\cf1 :\par
