\pard\f1\fs17\b0\sl200\slmult0\sa0 \cf3 """Problem 1: number source lines and extract Python functions."""\par
\pard\f1\fs17\b0\sl200\slmult0\sa0 \par
\pard\f1\fs17\b0\sl200\slmult0\sa0 \cf5 import\cf1  ast\par
\pard\f1\fs17\b0\sl200\slmult0\sa0 \cf5 import\cf1  io\par
\pard\f1\fs17\b0\sl200\slmult0\sa0 \cf5 from\cf1  pathlib \cf5 import\cf1  Path\par
\pard\f1\fs17\b0\sl200\slmult0\sa0 \cf5 import\cf1  tokenize\par
\pard\f1\fs17\b0\sl200\slmult0\sa0 \par
\pard\f1\fs17\b0\sl200\slmult0\sa0 \par
\pard\f1\fs17\b0\sl200\slmult0\sa0 \cf5 def\cf1  line_number(input_file: str, output_file: str) -> \cf5 None\cf1 :\par
\pard\f1\fs17\b0\sl200\slmult0\sa0 \cf1     \cf3 """Copy a text file, prefixing every line with its 1-based number."""\par
\pard\f1\fs17\b0\sl200\slmult0\sa0 \cf1     \cf5 try\cf1 :\par
\pard\f1\fs17\b0\sl200\slmult0\sa0 \cf1         source, target = Path(input_file), Path(output_file)\par
\pard\f1\fs17\b0\sl200\slmult0\sa0 \cf1         \cf5 if\cf1  source.resolve() == target.resolve() \cf5 or\cf1  (\par
\pard\f1\fs17\b0\sl200\slmult0\sa0 \cf1                 target.exists() \cf5 and\cf1  source.samefile(target)):\par
\pard\f1\fs17\b0\sl200\slmult0\sa0 \cf1             \cf5 raise\cf1  ValueError(\cf3 "Input and output must be different files."\cf1 )\par
\pard\f1\fs17\b0\sl200\slmult0\sa0 \cf1         \cf5 with\cf1  source.open(encoding=\cf3 "utf-8"\cf1 ) \cf5 as\cf1  reader:\par
\pard\f1\fs17\b0\sl200\slmult0\sa0 \cf1             lines = reader.readlines()\par
\pard\f1\fs17\b0\sl200\slmult0\sa0 \cf1         \cf5 with\cf1  target.open(\cf3 "w"\cf1 , encoding=\cf3 "utf-8"\cf1 ) \cf5 as\cf1  writer:\par
\pard\f1\fs17\b0\sl200\slmult0\sa0 \cf1             \cf5 for\cf1  number, line \cf5 in\cf1  enumerate(lines, \cf4 1\cf1 ):\par
\pard\f1\fs17\b0\sl200\slmult0\sa0 \cf1                 writer.write(f"\{number\}: \{line\}")\par
\pard\f1\fs17\b0\sl200\slmult0\sa0 \cf1     \cf5 except\cf1  (OSError, UnicodeError, ValueError) \cf5 as\cf1  error:\par
\pard\f1\fs17\b0\sl200\slmult0\sa0 \cf1         print(f"Could not number the file: \{error\}")\par
\pard\f1\fs17\b0\sl200\slmult0\sa0 \cf1         \cf5 raise\par
\pard\f1\fs17\b0\sl200\slmult0\sa0 \par
\pard\f1\fs17\b0\sl200\slmult0\sa0 \par
\pard\f1\fs17\b0\sl200\slmult0\sa0 \cf5 def\cf1  parse_functions(filename: str) -> tuple[tuple[int, str, str, str], ...]:\par
\pard\f1\fs17\b0\sl200\slmult0\sa0 \cf1     \cf3 """Return functions sorted by name as (line, name, arguments, code).\par
\pard\f1\fs17\b0\sl200\slmult0\sa0 \par
\pard\f1\fs17\b0\sl200\slmult0\sa0 \cf3     Include nested functions and methods. Keep docstrings and '#' inside\par
\pard\f1\fs17\b0\sl200\slmult0\sa0 \cf3     strings; remove comment tokens and empty lines from the returned code.\par
\pard\f1\fs17\b0\sl200\slmult0\sa0 \cf3     """\par
\pard\f1\fs17\b0\sl200\slmult0\sa0 \cf1     \cf5 try\cf1 :\par
\pard\f1\fs17\b0\sl200\slmult0\sa0 \cf1         \cf5 with\cf1  tokenize.open(filename) \cf5 as\cf1  reader:\par
\pard\f1\fs17\b0\sl200\slmult0\sa0 \cf1             source = reader.read()\par
\pard\f1\fs17\b0\sl200\slmult0\sa0 \cf1         functions = []\par
\pard\f1\fs17\b0\sl200\slmult0\sa0 \cf1         \cf5 for\cf1  node \cf5 in\cf1  ast.walk(ast.parse(source, filename)):\par
\pard\f1\fs17\b0\sl200\slmult0\sa0 \cf1             \cf5 if\cf1  \cf5 not\cf1  isinstance(node, (ast.FunctionDef, ast.AsyncFunctionDef)):\par
\pard\f1\fs17\b0\sl200\slmult0\sa0 \cf1                 \cf5 continue\par
\pard\f1\fs17\b0\sl200\slmult0\sa0 \cf1             code = ast.get_source_segment(source, node)\par
\pard\f1\fs17\b0\sl200\slmult0\sa0 \cf1             lines = code.splitlines(keepends=\cf5 True\cf1 )\par
\pard\f1\fs17\b0\sl200\slmult0\sa0 \cf1             tokens = list(tokenize.generate_tokens(io.StringIO(code).readline))\par
\pard\f1\fs17\b0\sl200\slmult0\sa0 \cf1             depth, start, end = \cf4 0\cf1 , \cf5 None\cf1 , \cf5 None\par
\pard\f1\fs17\b0\sl200\slmult0\sa0 \cf1             offsets = [\cf4 0\cf1 ]\par
\pard\f1\fs17\b0\sl200\slmult0\sa0 \cf1             \cf5 for\cf1  line \cf5 in\cf1  lines:\par
\pard\f1\fs17\b0\sl200\slmult0\sa0 \cf1                 offsets.append(offsets[-\cf4 1\cf1 ] + len(line))\par
\pard\f1\fs17\b0\sl200\slmult0\sa0 \cf1             \cf5 for\cf1  token \cf5 in\cf1  tokens:\par
\pard\f1\fs17\b0\sl200\slmult0\sa0 \cf1                 \cf5 if\cf1  token.type == tokenize.COMMENT:\par
\pard\f1\fs17\b0\sl200\slmult0\sa0 \cf1                     row, column = token.start\par
\pard\f1\fs17\b0\sl200\slmult0\sa0 \cf1                     lines[row - \cf4 1\cf1 ] = lines[row - \cf4 1\cf1 ][:column] + \cf3 "\\n"\par
\pard\f1\fs17\b0\sl200\slmult0\sa0 \cf1                 \cf5 if\cf1  token.type == tokenize.OP \cf5 and\cf1  end \cf5 is\cf1  \cf5 None\cf1 :\par
\pard\f1\fs17\b0\sl200\slmult0\sa0 \cf1                     \cf5 if\cf1  token.string == \cf3 "("\cf1 :\par
\pard\f1\fs17\b0\sl200\slmult0\sa0 \cf1                         \cf5 if\cf1  start \cf5 is\cf1  \cf5 None\cf1 :\par
\pard\f1\fs17\b0\sl200\slmult0\sa0 \cf1                             start = offsets[token.end[\cf4 0\cf1 ] - \cf4 1\cf1 ] + token.end[\cf4 1\cf1 ]\par
\pard\f1\fs17\b0\sl200\slmult0\sa0 \cf1                         depth += \cf4 1\par
\pard\f1\fs17\b0\sl200\slmult0\sa0 \cf1                     \cf5 elif\cf1  token.string == \cf3 ")"\cf1  \cf5 and\cf1  start \cf5 is\cf1  \cf5 not\cf1  \cf5 None\cf1 :\par
\pard\f1\fs17\b0\sl200\slmult0\sa0 \cf1                         depth -= \cf4 1\par
\pard\f1\fs17\b0\sl200\slmult0\sa0 \cf1                         \cf5 if\cf1  depth == \cf4 0\cf1 :\par
\page \pard\f0\fs28\b\sl360\slmult0\sa180 \cf1 Problem 1 Python file parsing continued\par
\pard\f0\fs20\b0\sl260\slmult0\sa120 \cf1 p1_Alfaro_Jorge.py\par
\pard\f1\fs17\b0\sl200\slmult0\sa0 \cf1                             end = offsets[token.start[\cf4 0\cf1 ] - \cf4 1\cf1 ] + token.start[\cf4 1\cf1 ]\par
\pard\f1\fs17\b0\sl200\slmult0\sa0 \cf1             arguments = code[start:end]\par
\pard\f1\fs17\b0\sl200\slmult0\sa0 \cf1             cleaned = \cf3 "\\n"\cf1 .join(line.rstrip() \cf5 for\cf1  line \cf5 in\cf1  lines \cf5 if\cf1  line.strip())\par
\pard\f1\fs17\b0\sl200\slmult0\sa0 \cf1             functions.append((node.lineno, node.name, arguments, cleaned + \cf3 "\\n"\cf1 ))\par
\pard\f1\fs17\b0\sl200\slmult0\sa0 \cf1         \cf5 return\cf1  tuple(sorted(functions, key=\cf5 lambda\cf1  item: item[\cf4 1\cf1 ]))\par
\pard\f1\fs17\b0\sl200\slmult0\sa0 \cf1     \cf5 except\cf1  (OSError, UnicodeError, SyntaxError, tokenize.TokenError) \cf5 as\cf1  error:\par
\pard\f1\fs17\b0\sl200\slmult0\sa0 \cf1         print(f"Could not parse Python functions: \{error\}")\par
\pard\f1\fs17\b0\sl200\slmult0\sa0 \cf1         \cf5 raise\par
\pard\f1\fs17\b0\sl200\slmult0\sa0 \par
\pard\f1\fs17\b0\sl200\slmult0\sa0 \par
\pard\f1\fs17\b0\sl200\slmult0\sa0 \cf5 def\cf1  main() -> \cf5 None\cf1 :\par
\pard\f1\fs17\b0\sl200\slmult0\sa0 \cf1     \cf3 """Demonstrate both functions using this source file."""\par
\pard\f1\fs17\b0\sl200\slmult0\sa0 \cf1     print(\cf3 "Student: Jorge Alfaro | FAU ID: Z23697022 | Problem 1"\cf1 )\par
\pard\f1\fs17\b0\sl200\slmult0\sa0 \cf1     source = Path(__file__).resolve()\par
\pard\f1\fs17\b0\sl200\slmult0\sa0 \cf1     destination = str(source) + \cf3 ".txt"\par
\pard\f1\fs17\b0\sl200\slmult0\sa0 \cf1     line_number(str(source), destination)\par
\pard\f1\fs17\b0\sl200\slmult0\sa0 \cf1     print(f"Numbered source saved to \{destination\}")\par
\pard\f1\fs17\b0\sl200\slmult0\sa0 \cf1     print(parse_functions(str(source)))\par
