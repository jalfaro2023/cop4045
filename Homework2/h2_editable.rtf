\pard\f1\fs17\b0\sl200\slmult0\sa0 \cf1         results = []\par
\pard\f1\fs17\b0\sl200\slmult0\sa0 \cf1         \cf5 for\cf1  user, name \cf5 in\cf1  [(\cf3 "alice"\cf1 , \cf3 "Alice Smith"\cf1 ), (\cf3 "maria"\cf1 , \cf3 "Maria Cortez"\cf1 ),\par
