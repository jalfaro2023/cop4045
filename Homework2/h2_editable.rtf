\pard\f1\fs17\b0\sl200\slmult0\sa0 \par
\pard\f1\fs17\b0\sl200\slmult0\sa0 \cf1     \cf2 # d. Compare sorted lowercase characters to identify anagrams.\par
\pard\f1\fs17\b0\sl200\slmult0\sa0 \cf1     lst1 = [\cf3 "Spam"\cf1 , \cf3 "Trams"\cf1 , \cf3 "Elbows"\cf1 , \cf3 "Tops"\cf1 , \cf3 "Astral"\cf1 ]\par
\pard\f1\fs17\b0\sl200\slmult0\sa0 \cf1     lst2 = [\cf3 "Bowels"\cf1 , \cf3 "Sample"\cf1 , \cf3 "Altars"\cf1 , \cf3 "Stop"\cf1 , \cf3 "Course"\cf1 , \cf3 "Smart"\cf1 ]\par
\pard\f1\fs17\b0\sl200\slmult0\sa0 \cf1     anagrams = [(w1, w2) \cf5 for\cf1  w1 \cf5 in\cf1  lst1 \cf5 for\cf1  w2 \cf5 in\cf1  lst2\par
\pard\f1\fs17\b0\sl200\slmult0\sa0 \cf1                 \cf5 if\cf1  sorted(w1.lower()) == sorted(w2.lower())]\par
\pard\f1\fs17\b0\sl200\slmult0\sa0 \cf1     print(\cf3 "d:"\cf1 , anagrams)\par
\pard\f1\fs17\b0\sl200\slmult0\sa0 \par
\pard\f1\fs17\b0\sl200\slmult0\sa0 \cf1     \cf2 # e. Map each distinct string to its length.\par
