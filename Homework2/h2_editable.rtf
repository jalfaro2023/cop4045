\pard\f1\fs17\b0\sl200\slmult0\sa0 \cf1     vowels = \{i: c \cf5 for\cf1  i, c \cf5 in\cf1  enumerate(text) \cf5 if\cf1  c.lower() \cf5 in\cf1  \cf3 "aeiou"\cf1 \}\par
\pard\f1\fs17\b0\sl200\slmult0\sa0 \cf1     print(\cf3 "f:"\cf1 , vowels)\par
\pard\f1\fs17\b0\sl200\slmult0\sa0 \par
\pard\f1\fs17\b0\sl200\slmult0\sa0 \par
\pard\f1\fs17\b0\sl200\slmult0\sa0 \cf5 if\cf1  __name__ == \cf3 "__main__"\cf1 :\par
\pard\f1\fs17\b0\sl200\slmult0\sa0 \cf1     main()\par
