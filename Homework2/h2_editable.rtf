\pard\f1\fs17\b0\sl200\slmult0\sa0 \cf1     print(\cf3 "e:"\cf1 , lengths)\par
\pard\f1\fs17\b0\sl200\slmult0\sa0 \par
\pard\f1\fs17\b0\sl200\slmult0\sa0 \cf1     \cf2 # f. Retain vowel positions and their original character case.\par
